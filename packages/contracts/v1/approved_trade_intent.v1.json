{
  "$id": "https://trader-bot.local/contracts/v1/approved_trade_intent.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovedTradeIntentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "decision_id",
    "risk_decision_id",
    "account_id",
    "instrument_id",
    "action",
    "order_plan",
    "risk_budget",
    "target_position_id",
    "valid_until",
    "idempotency_key",
    "approved_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "intent_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "risk_decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string"
    },
    "instrument_id": {
      "type": "string",
      "description": "Nautilus InstrumentId"
    },
    "action": {
      "type": "string",
      "enum": [
        "open_position",
        "add_position",
        "partial_close",
        "close_position",
        "move_stop_loss",
        "move_stop_to_entry",
        "replace_take_profits"
      ]
    },
    "order_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "risk_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_fraction",
        "max_notional",
        "max_leverage"
      ],
      "properties": {
        "risk_fraction": {
          "type": "number",
          "minimum": 0
        },
        "max_notional": {
          "type": "number",
          "minimum": 0
        },
        "max_leverage": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "target_position_id": {
      "type": [
        "null",
        "string"
      ]
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

