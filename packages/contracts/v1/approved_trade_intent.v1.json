{
  "$id": "https://trader-bot.local/contracts/v1/approved_trade_intent.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovedTradeIntentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "decision_id",
    "risk_decision_id",
    "account_id",
    "instrument_id",
    "action",
    "order_plan",
    "risk_budget",
    "target_position_id",
    "valid_until",
    "idempotency_key",
    "approved_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "intent_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "risk_decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string"
    },
    "instrument_id": {
      "type": "string",
      "description": "Nautilus InstrumentId"
    },
    "action": {
      "type": "string",
      "enum": [
        "open_position",
        "add_position",
        "partial_close",
        "close_position",
        "move_stop_loss",
        "move_stop_to_entry",
        "replace_take_profits"
      ]
    },
    "order_plan": {
      "type": "object",
      "description": "Action-specific execution plan carried into Nautilus; shape validated by the execution strategy per action. Open at the contract level (window C lock per window-B CCR). A's freeze had this as a closed empty object, which could carry no order detail and made the execution link unusable."
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional additive order-management execution hints. Absence preserves legacy/default v1 behavior: consumers continue to use order_plan and runtime defaults.",
      "properties": {
        "order_type": {
          "type": "string",
          "enum": [
            "market",
            "limit",
            "zone"
          ]
        },
        "time_in_force": {
          "type": "string",
          "enum": [
            "GTC",
            "IOC",
            "FOK",
            "GTD"
          ]
        },
        "post_only": {
          "type": "boolean"
        },
        "reduce_only": {
          "type": "boolean"
        },
        "max_slippage_bps": {
          "type": "number",
          "minimum": 0
        },
        "limit_price": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "zone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "high": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional additive order-management protection hints. Absence preserves legacy/default v1 behavior: runtime policy supplies protection defaults outside the envelope.",
      "properties": {
        "require_stop": {
          "type": "boolean"
        },
        "stop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "stop_market",
                "stop_limit"
              ]
            },
            "trigger_basis": {
              "type": "string",
              "enum": [
                "mark",
                "last"
              ]
            },
            "price": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "distance_pct": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "take_profits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "price": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "r_multiple": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fraction": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "quantity": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "time_in_force": {
                "type": "string",
                "enum": [
                  "GTC",
                  "IOC",
                  "FOK",
                  "GTD"
                ]
              }
            }
          }
        },
        "breakeven": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "trigger_r": {
              "type": "number",
              "minimum": 0
            },
            "offset_bps": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "trailing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "activation_r": {
              "type": "number",
              "minimum": 0
            },
            "callback_rate": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_step": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional additive order-management sizing hint. Absence preserves legacy/default v1 behavior through risk_budget and order_plan.",
      "properties": {
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "risk_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_fraction",
        "max_notional",
        "max_leverage"
      ],
      "properties": {
        "risk_fraction": {
          "type": "number",
          "minimum": 0
        },
        "max_notional": {
          "type": "number",
          "minimum": 0
        },
        "max_leverage": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "target_position_id": {
      "type": [
        "null",
        "string"
      ]
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
