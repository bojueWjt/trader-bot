{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts-v1/ApprovedTradeIntentV1",
  "title": "ApprovedTradeIntentV1",
  "description": "Frozen contract (PLAN v3.0 §3.2). Inbound to window B: consumed from the control-plane outbox/stream and carried into Nautilus as CustomData. Authoritative source: packages/contracts (window A).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "decision_id",
    "risk_decision_id",
    "account_id",
    "instrument_id",
    "action",
    "order_plan",
    "risk_budget",
    "valid_until",
    "idempotency_key",
    "approved_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "intent_id": { "type": "string", "format": "uuid" },
    "decision_id": { "type": "string", "format": "uuid" },
    "risk_decision_id": { "type": "string", "format": "uuid" },
    "account_id": { "type": "string", "minLength": 1 },
    "instrument_id": {
      "type": "string",
      "minLength": 1,
      "description": "Nautilus InstrumentId string, e.g. 'BTCUSDT-PERP.BINANCE'."
    },
    "action": {
      "type": "string",
      "enum": [
        "open_position",
        "add_position",
        "partial_close",
        "close_position",
        "move_stop_loss",
        "move_stop_to_entry",
        "replace_take_profits"
      ]
    },
    "order_plan": {
      "type": "object",
      "description": "Action-specific execution plan. Shape validated by the strategy per action; open object at the contract level."
    },
    "risk_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_fraction", "max_notional", "max_leverage"],
      "properties": {
        "risk_fraction": { "type": "number", "minimum": 0 },
        "max_notional": { "type": "number", "minimum": 0 },
        "max_leverage": { "type": "number", "minimum": 0 }
      }
    },
    "target_position_id": { "type": ["string", "null"] },
    "valid_until": { "type": "string", "format": "date-time" },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$",
      "description": "sha256 hex digest."
    },
    "approved_at": { "type": "string", "format": "date-time" }
  }
}
