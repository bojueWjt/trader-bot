{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts-v1/HermesDecisionV1",
  "title": "HermesDecisionV1",
  "description": "Frozen contract (PLAN v3.0 §3.1). Read-only for window B (window A produces it). Used by window B only for end-to-end trace assertions (raw_message_id -> decision_id -> ... -> venue_order_id). confidence MAY be recorded but MUST NOT directly trigger approval.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "decision_id",
    "raw_message_id",
    "processing_run_id",
    "context_snapshot_id",
    "classification",
    "intent",
    "evidence",
    "model",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "decision_id": { "type": "string", "format": "uuid" },
    "raw_message_id": { "type": "string", "format": "uuid" },
    "processing_run_id": { "type": "string", "format": "uuid" },
    "context_snapshot_id": { "type": "string", "format": "uuid" },
    "classification": {
      "type": "object",
      "required": ["message_type", "action", "ambiguous", "ambiguity_reasons"],
      "properties": {
        "message_type": {
          "type": "string",
          "enum": ["new_signal", "position_update", "close_update", "analysis", "noise", "ambiguous"]
        },
        "action": {
          "type": "string",
          "enum": [
            "open_position",
            "add_position",
            "partial_close",
            "close_position",
            "move_stop_loss",
            "move_stop_to_entry",
            "replace_take_profits",
            "hold",
            "ignore",
            "needs_review"
          ]
        },
        "ambiguous": { "type": "boolean" },
        "ambiguity_reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "intent": {
      "type": "object",
      "required": ["account_scope", "entry"],
      "properties": {
        "account_scope": { "type": "string", "enum": ["unassigned", "single", "all"] },
        "target_account_id": { "type": ["string", "null"] },
        "target_position_id": { "type": ["string", "null"] },
        "instrument_symbol": { "type": ["string", "null"] },
        "side": { "type": ["string", "null"] },
        "entry": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["market", "limit", "zone", "none"] },
            "price": { "type": ["number", "null"] },
            "price_min": { "type": ["number", "null"] },
            "price_max": { "type": ["number", "null"] }
          }
        },
        "stop_loss": { "type": ["number", "null"] },
        "take_profits": { "type": "array" },
        "leverage": { "type": ["number", "null"] },
        "valid_until": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "confidence": { "type": ["number", "null"] },
    "evidence": { "type": "array" },
    "model": {
      "type": "object",
      "required": ["provider", "model_version", "prompt_version", "temperature"],
      "properties": {
        "provider": { "type": "string" },
        "model_version": { "type": "string" },
        "prompt_version": { "type": "string" },
        "temperature": { "type": "number" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
