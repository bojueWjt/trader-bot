{
  "account_id": "account-c",
  "node_id": "nautilus-node-account-c",
  "trader_id": "TRADER-ACCOUNT-C",
  "instance_id": "INSTANCE-ACCOUNT-C",
  "redis": {
    "url": "redis://redis:6379/0",
    "key_prefix": "nautilus:account-c:node-c"
  },
  "binance": {
    "account_type": "USDT-M",
    "environment": "testnet",
    "api_key": {
      "env": "BINANCE_ACCOUNT_C_API_KEY",
      "file": "/run/secrets/binance_account_c_api_key"
    },
    "api_secret": {
      "env": "BINANCE_ACCOUNT_C_API_SECRET",
      "file": "/run/secrets/binance_account_c_api_secret"
    }
  },
  "control_plane": {
    "base_url": "http://control-plane:8080",
    "token": {
      "env": "CONTROL_PLANE_ACCOUNT_C_TOKEN",
      "file": "/run/secrets/control_plane_account_c_token"
    },
    "heartbeat_timeout_seconds": 15,
    "snapshot_stale_after_seconds": 30
  }
}
