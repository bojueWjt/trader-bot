[Unit]
Description=Trader v3: compute closed trade outcome metrics
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=balen
Group=balen
WorkingDirectory=/srv/trader-v3
EnvironmentFile=/etc/trader-v3/trade-outcomes.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=+/usr/bin/install -d -m 0750 /var/log/trader-v3
ExecStartPre=+/usr/bin/install -d -m 0750 /var/tmp/hermes-zone-klines
ExecStart=/usr/bin/flock -n /var/lock/trader-v3-trade-outcomes.lock /srv/trader-v3/.venv-cp/bin/python /srv/trader-v3/scripts/analysis/trade_outcomes.py --cache-dir /var/tmp/hermes-zone-klines --output /var/log/trader-v3/trade-outcomes-latest.json
StandardOutput=append:/var/log/trader-v3/trade-outcomes.log
StandardError=append:/var/log/trader-v3/trade-outcomes.log
TimeoutStartSec=2h
UMask=0027
