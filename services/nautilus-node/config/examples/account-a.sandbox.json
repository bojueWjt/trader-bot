{
  "account_id": "account-a",
  "node_id": "nautilus-node-account-a",
  "trader_id": "TRADER-ACCOUNT-A",
  "instance_id": "INSTANCE-ACCOUNT-A",
  "redis": {
    "url": "redis://localhost:6379/0",
    "key_prefix": "nautilus:account-a:node-a"
  },
  "binance": {
    "account_type": "USDT-M",
    "environment": "testnet",
    "api_key": {
      "env": "BINANCE_ACCOUNT_A_API_KEY",
      "file": "/run/secrets/binance_account_a_api_key"
    },
    "api_secret": {
      "env": "BINANCE_ACCOUNT_A_API_SECRET",
      "file": "/run/secrets/binance_account_a_api_secret"
    }
  },
  "control_plane": {
    "base_url": "http://control-plane:8080",
    "token": {
      "env": "CONTROL_PLANE_ACCOUNT_A_TOKEN",
      "file": "/run/secrets/control_plane_account_a_token"
    },
    "heartbeat_timeout_seconds": 15,
    "snapshot_stale_after_seconds": 30
  }
}
