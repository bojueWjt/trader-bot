{
  "account_id": "account-d",
  "node_id": "nautilus-node-account-d",
  "trader_id": "TRADER-ACCOUNT-D",
  "instance_id": "INSTANCE-ACCOUNT-D",
  "redis": {
    "url": "redis://localhost:6379/0",
    "key_prefix": "nautilus:account-d:node-d"
  },
  "binance": {
    "account_type": "USDT-M",
    "environment": "testnet",
    "api_key": {
      "env": "BINANCE_ACCOUNT_D_API_KEY",
      "file": "/run/secrets/binance_account_d_api_key"
    },
    "api_secret": {
      "env": "BINANCE_ACCOUNT_D_API_SECRET",
      "file": "/run/secrets/binance_account_d_api_secret"
    }
  },
  "control_plane": {
    "base_url": "http://control-plane:8080",
    "token": {
      "env": "CONTROL_PLANE_ACCOUNT_D_TOKEN",
      "file": "/run/secrets/control_plane_account_d_token"
    },
    "heartbeat_timeout_seconds": 15,
    "snapshot_stale_after_seconds": 30
  }
}
