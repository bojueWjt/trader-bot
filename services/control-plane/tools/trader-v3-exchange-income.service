[Unit]
Description=Trader v3: collect Binance USDT-M income (read-only)
After=network-online.target trader-v3-postgres.service
Wants=network-online.target

[Service]
Type=oneshot
User=balen
Group=balen
WorkingDirectory=/srv/trader-v3
EnvironmentFile=-/etc/trader-v3/exchange-income.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=+/usr/bin/install -d -m 0750 /var/log/trader-v3
ExecStart=/usr/bin/flock -n /var/lock/trader-v3-exchange-income.lock /srv/trader-v3/.venv-cp/bin/python /srv/trader-v3/services/control-plane/tools/exchange_income_collector.py --once
StandardOutput=append:/var/log/trader-v3/exchange-income.log
StandardError=append:/var/log/trader-v3/exchange-income.log
TimeoutStartSec=30min
UMask=0027
